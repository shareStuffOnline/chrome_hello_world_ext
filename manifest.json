{
  "manifest_version": 3,
  "name": "Chat Monitor Extension",
  "version": "1.0",
  "description": "Monitors chat responses and notifies the user.",
  "permissions": ["notifications", "tabs", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"], 
      "js": ["content.js"]
    }
  ]
}
